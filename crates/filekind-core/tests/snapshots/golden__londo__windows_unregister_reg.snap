Windows Registry Editor Version 5.00

; Generated by filekind [VERSION] — do not edit.
; Source: Londo Save (.londo)
; Regenerate with: filekind build
;
; Undoes windows/register.reg. Every register action filekind emits has a
; matching unregister action. That is mandatory, not a nicety.
;
; This file is deliberately conservative. It removes what filekind added and
; nothing else, because by the time you run it another application may also
; have registered for .londo.

; Remove our ProgID from the "Open with" list. The key itself stays: other
; applications may have their own entries in it.
[HKEY_CURRENT_USER\Software\Classes\.londo\OpenWithProgids]
"London.LondoSave.1"=-

; Clear the values filekind set on the extension key. A .reg file cannot say
; "only if it still points at us" — if you have since associated
; .londo with something else, delete this block before running.
[HKEY_CURRENT_USER\Software\Classes\.londo]
@=-
"Content Type"=-
"PerceivedType"=-

; The ProgID is ours alone, so it goes wholesale.
[-HKEY_CURRENT_USER\Software\Classes\London.LondoSave.1]

; And the MIME cross-reference.
[-HKEY_CURRENT_USER\Software\Classes\MIME\Database\Content Type\application/vnd.london.londo]
