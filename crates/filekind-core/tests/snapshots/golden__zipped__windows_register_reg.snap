---
source: crates/filekind-core/tests/golden.rs
expression: text
---
Windows Registry Editor Version 5.00

; Generated by filekind 0.5.0 — do not edit.
; Source: Studio Project (.studioproj)
; Regenerate with: filekind build
;
; Scope: HKEY_CURRENT_USER
; Per-user: no elevation, and nothing you cannot undo yourself.
;
; filekind emits this file rather than applying it. Read it first — that is
; the entire point of shipping a .reg instead of a register.exe.

; The extension itself
[HKEY_CURRENT_USER\Software\Classes\.studioproj]
@="Example.Studioproj.1"
"Content Type"="application/vnd.example.studioproj"
"PerceivedType"="compressed"

; Listing the ProgID here is what puts the type in Explorer's "Open with"
; menu. Note what is *not* here: an assignment making this the default
; handler. Windows 10 and later deliberately make that impossible from a
; script — only the user can pick a default, in Settings. Tools that work
; around the restriction get flagged as malware. Register, then prompt.
[HKEY_CURRENT_USER\Software\Classes\.studioproj\OpenWithProgids]
"Example.Studioproj.1"=""

; The ProgID
[HKEY_CURRENT_USER\Software\Classes\Example.Studioproj.1]
@="Studio project bundle"
"FriendlyTypeName"="Studio Project"

; No DefaultIcon: [windows].icon_path is unset and there is no handler
; executable to borrow an icon from. A loose .reg cannot know where your
; installer will put icon.ico, and inventing a path would register an icon
; that does not exist. Set [windows].icon_path, or use the Inno/NSIS snippet,
; which does know its own install directory.

; No shell\open\command: the spec declares no handler. The type will be
; named and described in Explorer, and double-clicking it will offer the
; "Open with" dialog.

; MIME cross-reference
; Lets components that speak MIME rather than extensions find their way back.
[HKEY_CURRENT_USER\Software\Classes\MIME\Database\Content Type\application/vnd.example.studioproj]
"Extension"=".studioproj"

; Explorer caches file-type information. If the change does not show up,
; restart explorer.exe or sign out and back in.
