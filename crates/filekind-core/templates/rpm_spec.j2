{{ banner_hash }}#
# Build with:
#     tar czf ~/rpmbuild/SOURCES/{{ slug }}-mime-{{ format_version }}.tar.gz \
#         --transform 's,^linux,{{ slug }}-mime-{{ format_version }},' linux
#     rpmbuild -bb {{ slug }}-mime.spec

Name:           {{ slug }}-mime
Version:        {{ format_version }}
Release:        1%{?dist}
Summary:        {{ name }} file type registration

License:        MIT
BuildArch:      noarch
Source0:        %{name}-%{version}.tar.gz

Requires:       shared-mime-info
Requires:       desktop-file-utils
BuildRequires:  desktop-file-utils

%description
Registers the {{ dotted_ext }} extension as {{ mime }}, including the
shared-mime-info entry, the desktop entry and the hicolor icons.

Generated by filekind {{ filekind_version }}. Edit the .filekind spec and
regenerate rather than patching this spec file.

%prep
%setup -q

%install
install -Dm644 {{ mime_file }} %{buildroot}%{_datadir}/mime/packages/{{ mime_file }}
desktop-file-install --dir=%{buildroot}%{_datadir}/applications {{ desktop_file }}
{% for s in hicolor_sizes %}
if [ -f icons/hicolor/{{ s }}x{{ s }}/mimetypes/{{ mime_icon_name }}.png ]; then
  install -Dm644 icons/hicolor/{{ s }}x{{ s }}/mimetypes/{{ mime_icon_name }}.png \
    %{buildroot}%{_datadir}/icons/hicolor/{{ s }}x{{ s }}/mimetypes/{{ mime_icon_name }}.png
fi
{%- endfor %}

%files
%{_datadir}/mime/packages/{{ mime_file }}
%{_datadir}/applications/{{ desktop_file }}
%{_datadir}/icons/hicolor/*/mimetypes/{{ mime_icon_name }}.png

%post
/usr/bin/update-mime-database %{_datadir}/mime &>/dev/null || :
/usr/bin/update-desktop-database %{_datadir}/applications &>/dev/null || :
/usr/bin/gtk-update-icon-cache -q -t -f %{_datadir}/icons/hicolor &>/dev/null || :

%postun
/usr/bin/update-mime-database %{_datadir}/mime &>/dev/null || :
/usr/bin/update-desktop-database %{_datadir}/applications &>/dev/null || :
/usr/bin/gtk-update-icon-cache -q -t -f %{_datadir}/icons/hicolor &>/dev/null || :

%changelog
* Thu Jan 01 1970 filekind <nobody@example.invalid> - {{ format_version }}-1
- Generated by filekind {{ filekind_version }}
