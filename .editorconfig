# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{rs}]
indent_size = 4
max_line_length = 100

[*.{js,ts,json,svelte,css,html,yml,yaml}]
indent_size = 2

[*.md]
# Markdown uses trailing double-space for hard line breaks.
trim_trailing_whitespace = false

[*.{sh,j2}]
indent_size = 4

[Makefile]
indent_style = tab

# Generated artifacts and fixtures are byte-exact on purpose.
[crates/filekind-core/tests/snapshots/**]
trim_trailing_whitespace = false
insert_final_newline = false
